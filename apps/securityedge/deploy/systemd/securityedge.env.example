# Install as /etc/securityedge/securityedge.env with owner root:securityedge and mode 0640.
# Replace both values before starting the service.
SECURITYEDGE_ADMIN_TOKEN=replace-with-a-strong-random-dashboard-token

# Must exactly match EDGEPROXY_ADMIN_TOKEN in /etc/edgeproxy/edgeproxy.env.
EDGEPROXY_ADMIN_TOKEN=replace-with-the-same-strong-edgeproxy-token

# Keep mutable gateway, Admin, WAF, EdgeProxy dependency, DNS, log, telemetry,
# and listener settings in /var/lib/securityedge/securityedge.json. Defining
# their SECURITYEDGE_* environment overrides intentionally pins those fields
# and takes precedence over later Dashboard/API changes.
