{
  "server": {
    "mode": "gateway",
    "listen_addr": "0.0.0.0:8081",
    "upstream_proxy_url": "http://edgeproxy:8080",
    "read_header_timeout": "5s",
    "read_timeout": "30s",
    "write_timeout": "60s",
    "idle_timeout": "90s",
    "shutdown_timeout": "10s",
    "max_header_bytes": 65536,
    "max_request_body_bytes": 8388608,
    "max_concurrent_requests": 512,
    "max_concurrent_per_client": 32,
    "trusted_proxy_cidrs": [],
    "forwarded_for_header": "X-Forwarded-For",
    "preserve_host": true,
    "add_security_headers": true,
    "upstream_transport": {
      "dial_timeout": "5s",
      "tls_handshake_timeout": "5s",
      "response_header_timeout": "30s",
      "expect_continue_timeout": "1s",
      "idle_conn_timeout": "90s",
      "max_idle_conns": 256,
      "max_idle_conns_per_host": 128,
      "max_conns_per_host": 0,
      "max_response_header_bytes": 1048576
    }
  },
  "admin": {
    "enabled": true,
    "listen_addr": "0.0.0.0:9191",
    "auth_token": "dev-security-token",
    "poll_timeout": "5s",
    "max_request_body_bytes": 1048576,
    "auth_failures_per_minute": 10,
    "auth_lockout_duration": "5m",
    "log_store": {
      "capacity": 10000,
      "default_page_size": 100,
      "max_page_size": 500,
      "file_path": "logs/security-events-compose.ndjson",
      "max_file_bytes": 20971520,
      "max_backups": 3
    },
    "connectivity": {
      "enabled": true,
      "check_interval": "5s",
      "timeout": "3s",
      "stale_after": "15s",
      "history_capacity": 50,
      "dns": {
        "enabled": false,
        "critical": false,
        "server": "127.0.0.1:53",
        "names": [],
        "expected_addresses": []
      }
    }
  },
  "edgeproxy": {
    "config_path": "../../../integration/edgeproxy-compose-behind-waf.json",
    "admin_url": "http://edgeproxy:9090",
    "admin_token": "dev-token",
    "timeout": "5s"
  },
  "waf": {
    "maximum_matches_per_request": 32,
    "custom_rules": []
  },
  "default_policy": {
    "enabled": true,
    "mode": "block",
    "anomaly_threshold": 5,
    "inspect_request_body": true,
    "max_inspection_body_bytes": 1048576,
    "body_content_types": [
      "application/json",
      "application/x-www-form-urlencoded",
      "multipart/form-data",
      "text/plain",
      "text/xml",
      "application/xml"
    ],
    "allowed_methods": [
      "GET",
      "HEAD",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "excluded_path_prefixes": [
      "/healthz"
    ],
    "disabled_rules": [],
    "ip_allowlist": [],
    "ip_denylist": [],
    "max_path_bytes": 4096,
    "max_query_bytes": 8192,
    "max_header_count": 100,
    "max_header_value_bytes": 8192,
    "reject_encoded_request_bodies": true,
    "rate_limit": {
      "enabled": true,
      "requests_per_second": 20,
      "burst": 40,
      "global_requests_per_second": 500,
      "global_burst": 1000,
      "cleanup_interval": "1m",
      "idle_ttl": "10m",
      "max_buckets": 100000
    },
    "auto_ban": {
      "enabled": true,
      "violation_threshold": 20,
      "window": "1m",
      "ban_duration": "10m",
      "max_tracked_clients": 100000
    },
    "reject_unsupported_body_types": false,
    "block_on_inspection_limit": true
  },
  "route_policies": {
    "demo-app": {
      "enabled": true,
      "mode": "block",
      "anomaly_threshold": 5,
      "inspect_request_body": true,
      "max_inspection_body_bytes": 1048576,
      "body_content_types": [
        "application/json",
        "application/x-www-form-urlencoded",
        "multipart/form-data",
        "text/plain",
        "text/xml",
        "application/xml"
      ],
      "allowed_methods": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "excluded_path_prefixes": [
        "/healthz"
      ],
      "disabled_rules": [],
      "ip_allowlist": [],
      "ip_denylist": [],
      "max_path_bytes": 4096,
      "max_query_bytes": 8192,
      "max_header_count": 100,
      "max_header_value_bytes": 8192,
      "reject_encoded_request_bodies": true,
      "rate_limit": {
        "enabled": true,
        "requests_per_second": 10,
        "burst": 20,
        "global_requests_per_second": 300,
        "global_burst": 600,
        "cleanup_interval": "1m",
        "idle_ttl": "10m",
        "max_buckets": 100000
      },
      "auto_ban": {
        "enabled": true,
        "violation_threshold": 20,
        "window": "1m",
        "ban_duration": "10m",
        "max_tracked_clients": 100000
      },
      "reject_unsupported_body_types": false,
      "block_on_inspection_limit": true
    }
  }
}
