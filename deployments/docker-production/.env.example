# SecureEdge Platform — standalone production Docker settings.
# Copy to .env and edit before first deployment. This production family has no
# runtime dependency on systemd, host service accounts, or prior SecureEdge
# installation paths. Credentials live under SECUREEDGE_DATA_ROOT/secrets.

# Self-contained host data root. bootstrap.sh creates and owns the complete
# Docker runtime tree below this directory using numeric container UID/GID IDs.
SECUREEDGE_DATA_ROOT=/srv/secureedge

# Numeric runtime identities used inside the production images and for bind
# mount ownership. Matching host users/groups are NOT required.
EDGEPROXY_UID=10001
EDGEPROXY_GID=10001
SECURITYEDGE_UID=10002
SECURITYEDGE_GID=10002

# ---------------------------------------------------------------------------
# EdgeProxy-only publication.
# Safe default is loopback-only. Set EDGEPROXY_HTTPS_BIND_IP=0.0.0.0 and
# EDGEPROXY_HTTPS_PORT=443 only when intentionally exposing standalone
# EdgeProxy. Full-platform mode never publishes the EdgeProxy data plane.
# ---------------------------------------------------------------------------
EDGEPROXY_HTTPS_BIND_IP=127.0.0.1
EDGEPROXY_HTTPS_PORT=8443
EDGEPROXY_CONTAINER_HTTPS_PORT=8443
EDGEPROXY_PUBLIC_HOSTNAME=edgeproxy.example.invalid
EDGEPROXY_ADMIN_BIND_IP=127.0.0.1
EDGEPROXY_ADMIN_PORT=9090
EDGEPROXY_TRUSTED_PROXY_CIDRS=

# Full-platform private EdgeProxy endpoint. Use a hostname covered by the
# EdgeProxy TLS certificate (typically a private/internal SAN).
EDGEPROXY_INTERNAL_HOSTNAME=edgeproxy.internal.example.invalid
EDGEPROXY_INTERNAL_SCHEME=https
EDGEPROXY_INTERNAL_PORT=8443
EDGEPROXY_INTERNAL_TLS_ENABLED=true
EDGEPROXY_TLS_CERT_FILE_CONTAINER=/etc/edgeproxy/tls/fullchain.pem
EDGEPROXY_TLS_KEY_FILE_CONTAINER=/etc/edgeproxy/tls/privkey.pem

# Origin transport guardrails. Production defaults require HTTPS and verified
# certificates. Relax only for an explicitly documented controlled network.
EDGEPROXY_REQUIRE_HTTPS_ORIGINS=true
EDGEPROXY_ALLOW_INSECURE_ORIGIN_TLS=false

# ---------------------------------------------------------------------------
# SecurityEdge publication.
# ---------------------------------------------------------------------------
SECURITYEDGE_HTTPS_BIND_IP=0.0.0.0
SECURITYEDGE_HTTPS_PORT=443
SECURITYEDGE_CONTAINER_HTTPS_PORT=8443
SECURITYEDGE_PUBLIC_HOSTNAME=secureedge.example.invalid
SECURITYEDGE_ADMIN_BIND_IP=127.0.0.1
SECURITYEDGE_ADMIN_PORT=9191
SECURITYEDGE_TLS_CERT_FILE_CONTAINER=/etc/securityedge/tls/fullchain.pem
SECURITYEDGE_TLS_KEY_FILE_CONTAINER=/etc/securityedge/tls/privkey.pem
SECURITYEDGE_TRUSTED_PROXY_CIDRS=

# SecurityEdge-only mode connects to an independently operated EdgeProxy.
# The data plane may be HTTPS. EdgeProxy Admin itself is HTTP-only, so its
# Admin URL MUST be carried over a trusted private/VPN network when remote.
SECURITYEDGE_EXTERNAL_EDGEPROXY_URL=https://edgeproxy.example.invalid:8443
SECURITYEDGE_EXTERNAL_EDGEPROXY_ADMIN_URL=http://edgeproxy.example.invalid:9090
SECURITYEDGE_REQUIRE_HTTPS_EDGEPROXY=true

# Optional DNS connectivity probe. Disabled by default so a fresh Docker
# deployment does not inherit local/LAN DNS assumptions.
SECURITYEDGE_DNS_ENABLED=false
SECURITYEDGE_DNS_CRITICAL=false
SECURITYEDGE_DNS_SERVER=127.0.0.1:53
SECURITYEDGE_DNS_NAMES=
SECURITYEDGE_DNS_EXPECTED_ADDRESSES=

# Private network used only by compose.platform.yml. Pick a subnet that does
# not overlap cloud/LAN/VPN/Tailscale routes.
SECUREEDGE_PROD_SUBNET=172.31.250.0/24
SECURITYEDGE_CONTAINER_IPV4=172.31.250.10
SECURITYEDGE_TRUSTED_PROXY_CIDR=172.31.250.10/32

# Resource limits. Defaults fit a small production VPS while leaving headroom
# for Linux, Docker, TLS, networking and page cache.
EDGEPROXY_CPUS=0.75
EDGEPROXY_MEMORY_LIMIT=512m
EDGEPROXY_PIDS_LIMIT=256
SECURITYEDGE_CPUS=1.00
SECURITYEDGE_MEMORY_LIMIT=768m
SECURITYEDGE_PIDS_LIMIT=384

# Images/build metadata.
EDGEPROXY_IMAGE=secureedge/edgeproxy:production
SECURITYEDGE_IMAGE=secureedge/securityedge:production
SECUREEDGE_VERSION=production
SECUREEDGE_COMMIT=unknown
SECUREEDGE_BUILD_TIME=unknown
