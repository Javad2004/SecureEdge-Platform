# Copy this file to .env and replace the demonstration credentials.
SECURITYEDGE_ADMIN_TOKEN=replace-with-a-strong-random-dashboard-token
EDGEPROXY_ADMIN_TOKEN=replace-with-a-strong-random-shared-token

# Optional published host ports.
SECURITYEDGE_HTTP_PORT=8081
SECURITYEDGE_ADMIN_PORT=9191

# Optional build metadata.
SECURITYEDGE_COMMIT=local
SECURITYEDGE_BUILD_TIME=unknown
