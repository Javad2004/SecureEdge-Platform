# Install as /etc/edgeproxy/edgeproxy.env with owner root:edgeproxy and mode 0640.
# Replace the value before starting the service. The systemd unit requires this
# file, while the runtime token overrides the non-secret placeholder stored in
# /var/lib/edgeproxy/config.json.
EDGEPROXY_ADMIN_TOKEN=replace-with-a-strong-random-edgeproxy-token

# Keep mutable listener, TLS, trusted-proxy, Route, cache, and Admin settings in
# /var/lib/edgeproxy/config.json so Dashboard/API updates remain authoritative.
# Setting their EDGEPROXY_* environment overrides intentionally pins those
# fields and takes precedence over later Control Plane changes.
