[Unit]
Description=SecureEdge Platform EdgeProxy
Documentation=https://github.com/Javad2004/SecureEdge-Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgeproxy
Group=edgeproxy

# Keep deployment secrets read-only under /etc and the transactionally managed
# JSON profile under /var/lib. Atomic replacement and timestamped backups require
# write access to the directory containing the active configuration file.
EnvironmentFile=/etc/edgeproxy/edgeproxy.env
StateDirectory=edgeproxy
StateDirectoryMode=0750
WorkingDirectory=/var/lib/edgeproxy
ExecStart=/usr/local/bin/edgeproxy -config /var/lib/edgeproxy/config.json
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

# The integrated profile keeps EdgeProxy on unprivileged loopback ports.
# SecurityEdge owns public port 80, so EdgeProxy receives no ambient capability.
# Keep the bounding set narrow in case a future binary or child process carries
# file capabilities; NoNewPrivileges still prevents acquiring them at runtime.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/etc/edgeproxy
ReadWritePaths=/var/lib/edgeproxy
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
