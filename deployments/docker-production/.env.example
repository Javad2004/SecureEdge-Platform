# SecureEdge Platform production Docker settings.
# Copy to .env and adjust for the target Linux host. Do not place credentials
# in this file; Admin tokens are mounted through Docker secrets.

# Host state paths. Keeping the systemd production paths makes migration and
# rollback possible without copying mutable Control Plane state.
EDGEPROXY_STATE_DIR=/var/lib/edgeproxy
SECURITYEDGE_STATE_DIR=/var/lib/securityedge
SECURITYEDGE_LOG_DIR=/var/log/securityedge
EDGEPROXY_TLS_DIR=/etc/edgeproxy/tls
SECURITYEDGE_TLS_DIR=/etc/securityedge/tls

# Optional private CA certificates (PEM/CRT). Keep this directory empty when
# only public/system-trusted certificates are used.
SECUREEDGE_CA_DIR=/etc/secureedge/ca

# Numeric runtime identities. On an existing systemd deployment use:
#   id -u edgeproxy; id -g edgeproxy
#   id -u securityedge; id -g securityedge
# The production bootstrap script rewrites these automatically when those
# system users exist.
EDGEPROXY_UID=10001
EDGEPROXY_GID=10001
SECURITYEDGE_UID=10002
SECURITYEDGE_GID=10002

# Secret source files. Each file contains only the raw token and is kept out of
# Git by deployments/docker-production/.gitignore.
EDGEPROXY_ADMIN_TOKEN_FILE=./secrets/edgeproxy_admin_token
SECURITYEDGE_ADMIN_TOKEN_FILE=./secrets/securityedge_admin_token

# Public SecurityEdge listener for the combined container deployment.
SECURITYEDGE_HTTPS_BIND_IP=0.0.0.0
SECURITYEDGE_HTTPS_PORT=443
SECURITYEDGE_PUBLIC_HOSTNAME=secureedge.example.com
SECURITYEDGE_ADMIN_PORT=9191
EDGEPROXY_ADMIN_PORT=9090
SECURITYEDGE_CONTAINER_HTTPS_PORT=8443

# Private Docker network used only by compose.platform.yml. Choose a subnet
# that does not overlap Docker, LAN, cloud, or VPN/Tailscale routes.
SECUREEDGE_PROD_SUBNET=172.31.250.0/24
SECURITYEDGE_CONTAINER_IPV4=172.31.250.10
SECURITYEDGE_TRUSTED_PROXY_CIDR=172.31.250.10/32

# EdgeProxy's private service endpoint in compose.platform.yml. Production
# defaults to HTTPS end-to-end. Set the hostname to a SAN covered by the
# EdgeProxy certificate. Operators who explicitly accept plaintext on the
# host-local private bridge may opt out with scheme=http, port=8080, TLS=false.
EDGEPROXY_INTERNAL_HOSTNAME=edgeproxy.example.com
EDGEPROXY_INTERNAL_SCHEME=https
EDGEPROXY_INTERNAL_PORT=8443
EDGEPROXY_INTERNAL_TLS_ENABLED=true
EDGEPROXY_TLS_CERT_FILE_CONTAINER=/etc/edgeproxy/tls/fullchain.pem
EDGEPROXY_TLS_KEY_FILE_CONTAINER=/etc/edgeproxy/tls/privkey.pem

# Production Origin transport guardrails. Disable only for a deliberately
# controlled environment and document the exception.
EDGEPROXY_REQUIRE_HTTPS_ORIGINS=true
EDGEPROXY_ALLOW_INSECURE_ORIGIN_TLS=false

# SecurityEdge always terminates public TLS in the combined production stack.
SECURITYEDGE_TLS_CERT_FILE_CONTAINER=/etc/securityedge/tls/fullchain.pem
SECURITYEDGE_TLS_KEY_FILE_CONTAINER=/etc/securityedge/tls/privkey.pem

# Optional trusted upstream proxy CIDRs in front of SecurityEdge, comma
# separated. Leave empty when clients connect directly to SecurityEdge.
SECURITYEDGE_TRUSTED_PROXY_CIDRS=

# Resource limits are intentionally configurable per host. Defaults fit a
# small VPS while leaving memory for Docker, Linux, TLS, and page cache.
EDGEPROXY_CPUS=0.75
EDGEPROXY_MEMORY_LIMIT=512m
EDGEPROXY_PIDS_LIMIT=256
SECURITYEDGE_CPUS=1.00
SECURITYEDGE_MEMORY_LIMIT=768m
SECURITYEDGE_PIDS_LIMIT=384

# Container image names and build metadata.
EDGEPROXY_IMAGE=secureedge/edgeproxy:production
SECURITYEDGE_IMAGE=secureedge/securityedge:production
SECUREEDGE_VERSION=production
SECUREEDGE_COMMIT=unknown
SECUREEDGE_BUILD_TIME=unknown
