[Unit]
Description=SecureEdge Platform SecurityEdge Gateway
Documentation=https://github.com/Javad2004/SecureEdge-Platform
After=network-online.target edgeproxy.service
Wants=network-online.target
Requires=edgeproxy.service

[Service]
Type=simple
User=securityedge
Group=securityedge
SupplementaryGroups=edgeproxy

# Secrets and path overrides stay read-only in /etc. The active SecurityEdge
# configuration, telemetry history, and security logs use systemd-managed state
# and log directories so Dashboard/API writes remain atomic under ProtectSystem.
EnvironmentFile=/etc/securityedge/securityedge.env
StateDirectory=securityedge
StateDirectoryMode=0750
LogsDirectory=securityedge
LogsDirectoryMode=0750
WorkingDirectory=/var/lib/securityedge
ExecStart=/usr/local/bin/securityedge -config /var/lib/securityedge/securityedge.json
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

# The checked-in gateway profile listens on port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/etc/securityedge /var/lib/edgeproxy
ReadWritePaths=/var/lib/securityedge /var/log/securityedge
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
