[Unit]
Description=EdgeProxy Go Reverse Proxy and Cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgeproxy
Group=edgeproxy
EnvironmentFile=-/etc/edgeproxy/edgeproxy.env
ExecStart=/usr/local/bin/edgeproxy -config /etc/edgeproxy/config.json
Restart=on-failure
RestartSec=3

# The three-device configuration listens on HTTP port 80 while the service runs
# as an unprivileged user. Grant only the capability required for low ports.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/etc/edgeproxy
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
