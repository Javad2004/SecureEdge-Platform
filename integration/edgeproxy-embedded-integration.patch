+func TestEmbeddedSecurityEnvironmentUsesIndependentManagedState(t *testing.T) {
+	edgeKey := "EDGEPROXY_EMBEDDED_ENV_ISOLATION_TEST"
+	securityKey := "SECURITYEDGE_EMBEDDED_ENV_ISOLATION_TEST"
+
+	type oldValue struct {
+		value string
+		set   bool
+	}
+	old := map[string]oldValue{}
+	for _, key := range []string{edgeKey, securityKey} {
+		value, set := os.LookupEnv(key)
+		old[key] = oldValue{value: value, set: set}
+		if err := os.Unsetenv(key); err != nil {
+			t.Fatal(err)
+		}
+	}
+	defer func() {
+		for key, previous := range old {
+			if previous.set {
+				_ = os.Setenv(key, previous.value)
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		}
+	}()
+
+	edgeSnapshot := edgeenv.SnapshotManagedEnvironment()
+	defer func() {
+		if err := edgeenv.RestoreManagedEnvironment(edgeSnapshot); err != nil {
+			t.Errorf("restore EdgeProxy managed environment: %v", err)
+		}
+	}()
+
+	dir := t.TempDir()
+	edgePath := filepath.Join(dir, "edge.env")
+	securityPath := filepath.Join(dir, "security.env")
+	if err := os.WriteFile(edgePath, []byte(edgeKey+"=edge-one\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(securityPath, []byte(securityKey+"=security-one\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := edgeenv.Load(edgePath); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := securityedge.LoadEnvironmentFile(securityPath); err != nil {
+		t.Fatal(err)
+	}
+	if got := os.Getenv(edgeKey); got != "edge-one" {
+		t.Fatalf("EdgeProxy dotenv value=%q, want edge-one", got)
+	}
+	if got := os.Getenv(securityKey); got != "security-one" {
+		t.Fatalf("SecurityEdge dotenv value=%q, want security-one", got)
+	}
+
+	if err := os.WriteFile(edgePath, []byte(edgeKey+"=edge-two\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := edgeenv.Reload(edgePath); err != nil {
+		t.Fatal(err)
+	}
+	if got := os.Getenv(edgeKey); got != "edge-two" {
+		t.Fatalf("reloaded EdgeProxy dotenv value=%q, want edge-two", got)
+	}
+	if got := os.Getenv(securityKey); got != "security-one" {
+		t.Fatalf("EdgeProxy dotenv reload changed SecurityEdge-owned value: %q", got)
+	}
+}
