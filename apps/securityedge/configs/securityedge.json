{
  "server": {
    "mode": "gateway",
    "listen_addr": "0.0.0.0:80",
    "upstream_proxy_url": "http://127.0.0.1:8080",
    "read_header_timeout": "5s",
    "read_timeout": "30s",
    "write_timeout": "60s",
    "idle_timeout": "90s",
    "shutdown_timeout": "10s",
    "max_header_bytes": 1048576
  },
  "admin": {
    "enabled": true,
    "listen_addr": "127.0.0.1:9191",
    "auth_token": "SecurityEdgeDemo2026",
    "poll_timeout": "5s",
    "log_store": { "capacity": 5000, "default_page_size": 100, "max_page_size": 500 }
  },
  "edgeproxy": {
    "config_path": "../integration/edgeproxy-behind-waf.json",
    "admin_url": "http://127.0.0.1:9090",
    "admin_token": "EdgeProxyDemo2026",
    "timeout": "5s"
  },
  "default_policy": {
    "enabled": true,
    "mode": "block",
    "anomaly_threshold": 5,
    "inspect_request_body": true,
    "max_inspection_body_bytes": 1048576,
    "body_content_types": ["application/json", "application/x-www-form-urlencoded", "multipart/form-data", "text/plain", "text/xml", "application/xml"],
    "allowed_methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "excluded_path_prefixes": ["/healthz"],
    "disabled_rules": [],
    "ip_allowlist": [],
    "ip_denylist": [],
    "rate_limit": { "enabled": true, "requests_per_second": 20, "burst": 40, "cleanup_interval": "1m", "idle_ttl": "10m" }
  },
  "route_policies": {
    "demo-app": {
      "enabled": true,
      "mode": "block",
      "anomaly_threshold": 5,
      "inspect_request_body": true,
      "max_inspection_body_bytes": 1048576,
      "body_content_types": ["application/json", "application/x-www-form-urlencoded", "multipart/form-data", "text/plain", "text/xml", "application/xml"],
      "allowed_methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "excluded_path_prefixes": ["/healthz"],
      "disabled_rules": [],
      "ip_allowlist": [],
      "ip_denylist": [],
      "rate_limit": { "enabled": true, "requests_per_second": 10, "burst": 20, "cleanup_interval": "1m", "idle_ttl": "10m" }
    }
  }
}
