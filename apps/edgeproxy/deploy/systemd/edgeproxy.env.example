# Install as /etc/edgeproxy/edgeproxy.env with owner root:edgeproxy and mode 0640.
# Use a strong random value and keep this file outside the writable state directory.
EDGEPROXY_ADMIN_TOKEN=replace-with-a-strong-random-edgeproxy-token

# Recommended when SecurityEdge is the only public ingress.
EDGEPROXY_SERVER_LISTEN_ADDR=127.0.0.1:8080
EDGEPROXY_ADMIN_LISTEN_ADDR=127.0.0.1:9090

# Optional TLS termination at EdgeProxy. Leave disabled when TLS terminates at
# SecurityEdge or another trusted ingress.
EDGEPROXY_TLS_ENABLED=false
EDGEPROXY_TLS_CERT_FILE=
EDGEPROXY_TLS_KEY_FILE=
