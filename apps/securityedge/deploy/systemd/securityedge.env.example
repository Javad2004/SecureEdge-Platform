# Install as /etc/securityedge/securityedge.env with owner root:securityedge and mode 0640.
SECURITYEDGE_ADMIN_TOKEN=replace-with-a-strong-random-dashboard-token

# Must match EDGEPROXY_ADMIN_TOKEN in /etc/edgeproxy/edgeproxy.env.
EDGEPROXY_ADMIN_TOKEN=replace-with-the-same-strong-edgeproxy-token

# The SecurityEdge process reads the authoritative EdgeProxy Route table through
# its supplementary edgeproxy group. EdgeProxy remains the only writer.
SECURITYEDGE_EDGEPROXY_CONFIG_PATH=/var/lib/edgeproxy/config.json
SECURITYEDGE_EDGEPROXY_ADMIN_URL=http://127.0.0.1:9090

# Keep mutable operational data out of /etc and inside systemd-managed paths.
SECURITYEDGE_LOG_FILE_PATH=/var/log/securityedge/security-events.ndjson
SECURITYEDGE_TELEMETRY_HISTORY_FILE=/var/lib/securityedge/telemetry-history.json

SECURITYEDGE_SERVER_LISTEN_ADDR=0.0.0.0:80
SECURITYEDGE_ADMIN_LISTEN_ADDR=127.0.0.1:9191
