# SecurityEdge environment template for the three-device LAN deployment.
# Copy to .env, replace demonstration secrets and network values, and keep .env out of Git.

# Optional JSON profile. Relative paths are resolved from this .env file.
SECURITYEDGE_CONFIG=configs/securityedge.json

# Public ingress and local operations listener. The reference LAN profile keeps
# TLS disabled. Leave TLS fields blank to inherit JSON; set ENABLED=true plus
# both certificate paths when terminating HTTPS natively through environment overrides.
SECURITYEDGE_SERVER_LISTEN_ADDR=0.0.0.0:80
SECURITYEDGE_TLS_ENABLED=
SECURITYEDGE_TLS_CERT_FILE=
SECURITYEDGE_TLS_KEY_FILE=
SECURITYEDGE_ADMIN_LISTEN_ADDR=127.0.0.1:9191
SECURITYEDGE_ADMIN_TOKEN=replace-with-a-strong-random-dashboard-token

# Internal SecurityEdge -> EdgeProxy data-plane and Admin API endpoints.
SECURITYEDGE_UPSTREAM_PROXY_URL=http://127.0.0.1:8080
SECURITYEDGE_EDGEPROXY_ADMIN_URL=http://127.0.0.1:9090
SECURITYEDGE_EDGEPROXY_CONFIG_PATH=../../../integration/edgeproxy-behind-waf.json

# Must exactly match EDGEPROXY_ADMIN_TOKEN in apps/edgeproxy/.env.
EDGEPROXY_ADMIN_TOKEN=replace-with-a-strong-random-shared-token

# Trusted upstream proxies in front of SecurityEdge. Leave empty for direct LAN clients.
SECURITYEDGE_TRUSTED_PROXY_CIDRS=
SECURITYEDGE_FORWARDED_FOR_HEADER=X-Forwarded-For

# Technitium DNS acceptance and connectivity checks.
SECURITYEDGE_DNS_ENABLED=true
SECURITYEDGE_DNS_CRITICAL=true
SECURITYEDGE_DNS_SERVER=10.36.74.241:53
SECURITYEDGE_DNS_NAMES=project.test,www.project.test
SECURITYEDGE_DNS_EXPECTED_ADDRESSES=10.36.74.241

# Persistent security-event and bounded telemetry-history paths, relative to the process working directory.
SECURITYEDGE_LOG_FILE_PATH=logs/security-events.ndjson
SECURITYEDGE_TELEMETRY_HISTORY_FILE=logs/telemetry-history.json
