# EdgeProxy environment template for the three-device LAN deployment.
# Copy to .env, replace demonstration secrets and network values, and keep .env out of Git.

# Optional JSON profile. Relative paths are resolved from this .env file.
EDGEPROXY_CONFIG=../../integration/edgeproxy-behind-waf.json

# EdgeProxy listeners.
EDGEPROXY_SERVER_LISTEN_ADDR=127.0.0.1:8080
EDGEPROXY_ADMIN_LISTEN_ADDR=127.0.0.1:9090

# Shared credential used by SecurityEdge when calling the EdgeProxy Admin API.
# Use the exact same value in apps/securityedge/.env.
EDGEPROXY_ADMIN_TOKEN=replace-with-a-strong-random-shared-token

# SecurityEdge peers whose forwarded client-address header EdgeProxy may trust.
# Comma-separated CIDR values. Loopback is correct when both services run on one host.
EDGEPROXY_TRUSTED_PROXY_CIDRS=127.0.0.1/32
EDGEPROXY_FORWARDED_FOR_HEADER=X-Forwarded-For

# Route-specific Origin override. The route name "demo-app" becomes DEMO_APP.
# Route names, hosts, and path prefixes stay in the shared JSON route table so
# EdgeProxy and SecurityEdge always enforce the same routing contract.
EDGEPROXY_ROUTE_DEMO_APP_UPSTREAM_URLS=http://10.36.74.43:9000

# Optional EdgeProxy TLS settings. Keep TLS disabled unless EdgeProxy terminates HTTPS directly.
# Leave the certificate and key paths empty while TLS is disabled.
EDGEPROXY_TLS_ENABLED=false
EDGEPROXY_TLS_CERT_FILE=
EDGEPROXY_TLS_KEY_FILE=

# Demo Origin process settings used by cmd/origin-demo.
ORIGIN_DEMO_LISTEN_ADDR=0.0.0.0:9000
ORIGIN_DEMO_NAME=origin-a
